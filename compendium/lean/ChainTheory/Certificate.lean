def publicDeclarations : List Name := publicDeclarationsBase ++ publicDeclarationsV10 ++ publicDeclarationsEighth ++ publicDeclarationsNinth

def axiomsOf (env : Environment) (n : Name) : IO (Array Name) := do
  let act : CoreM (Array Name) := collectAxioms n
  let (axs, _) ← act.toIO {fileName := "", fileMap := default} {env := env}
  return axs

def main : IO Unit := do
  IO.println "CERTIFICATE CHECKER of ChainTheory: the closed finite checks re-decided at the run of this executable from the data modules alone, then the census of declarations and axioms"
  IO.println "FACE ONE: the build is the check (the kernel decided every CLOSED theorem at the build; this executable adds nothing the kernel did not certify). FACE TWO: this executable re-decides at its run through the compiled code beside the kernel and prints one transcript a reviewer runs. Both faces printed, selected never."
  let mut bad := 0
  for (n, b) in runtimeChecks ++ packageChecks do
    IO.println s!"RE-DECIDED {n} {if b then "TRUE" else "FALSE"}"
    if !b then bad := bad + 1
  IO.println s!"RE-DECIDED checks {(runtimeChecks ++ packageChecks).length}, FALSE {bad}"
  initSearchPath (← findSysroot)
  let env ← importModules #[{module := `ChainTheory}] {} 0
  let mut total := 0; let mut free := 0; let mut pe := 0; let mut qs := 0; let mut both := 0; let mut beyond := 0; let mut sorryN := 0; let mut choice := 0; let mut native := 0
  for n in publicDeclarations do
    let axs ← axiomsOf env n
    let names := axs.map toString
    IO.println s!"AXIOMS {n} {names.toList}"
    total := total + 1
    let s := names.toList
    if s.isEmpty then free := free + 1
    else if s == ["propext"] then pe := pe + 1
    else if s == ["Quot.sound"] then qs := qs + 1
    else if s == ["propext", "Quot.sound"] then both := both + 1
    else beyond := beyond + 1
    if s.contains "sorryAx" then sorryN := sorryN + 1
    if s.contains "Classical.choice" then choice := choice + 1
    if s.contains "Lean.ofReduceBool" then native := native + 1
  IO.println s!"CENSUS declarations {total}; axiom-free {free}; propext alone {pe}; Quot.sound alone {qs}; propext and Quot.sound {both}; beyond the census {beyond}; sorryAx {sorryN}; Classical.choice {choice}; Lean.ofReduceBool {native}"
  IO.println s!"CERTIFICATE {if bad == 0 && beyond == 0 && sorryN == 0 && native == 0 then "PASS" else "FAIL"}"
