#eval show Lean.Elab.Command.CommandElabM Unit from do
  let env ← Lean.getEnv
  let root : Name := `AxiomDeclarationTwo.WorldTwo
  let first : Name := `AxiomDeclaration.World
  let web : Name := `ActClosure.Web
  let mut yes := 0
  let mut no := 0
  let mut fy := 0
  let mut wy := 0
  for n in auditNames do
    let s := rootWalk env 2000000 [n] {}
    if s.contains first then fy := fy + 1
    if s.contains web then wy := wy + 1
