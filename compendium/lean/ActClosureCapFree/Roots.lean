      yes := yes + 1
      IO.println s!"'{n}' ROOT YES"
    else
      no := no + 1
      IO.println s!"'{n}' ROOT NO"
  IO.println s!"ROOT CENSUS declarations {auditNames.length} rooted at WorldTwo {yes} not rooted {no} at World {fy} at Web {wy}"
