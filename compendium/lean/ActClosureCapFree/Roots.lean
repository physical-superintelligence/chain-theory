def rootWalk (env : Environment) : Nat → List Name → NameSet → NameSet
  | 0, _, seen => seen
  | _, [], seen => seen
  | fuel + 1, n :: rest, seen =>
    if seen.contains n then rootWalk env fuel rest seen
    else
      let next := match env.find? n with
        | some ci => ci.getUsedConstantsAsSet.toList
        | none => []
      rootWalk env fuel (next ++ rest) (seen.insert n)

