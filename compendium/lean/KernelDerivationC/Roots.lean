#eval show Lean.Elab.Command.CommandElabM Unit from do
  let env ← Lean.getEnv
  let root : Name := `AxiomDeclarationTwo.WorldTwo
  let mut yes := 0
  let mut no := 0
  for n in auditNames do
    let s := rootWalk env 2000000 [n] {}
    if s.contains root then
      yes := yes + 1
      IO.println s!"'{n}' ROOT YES"
    else
      no := no + 1
      IO.println s!"'{n}' ROOT NO"
  IO.println s!"ROOT CENSUS declarations {auditNames.length} rooted at WorldTwo {yes} not rooted {no}"
